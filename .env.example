# SpendSense AI — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Required ─────────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens — make this long and random
SECRET_KEY=your_super_secret_key_change_this_in_production

# Gemini API Key — get from https://aistudio.google.com/app/apikey
# If left empty, the app works in ML-only mode (agents return placeholder text)
GOOGLE_API_KEY=your_gemini_api_key_here

# ─── Optional ─────────────────────────────────────────────────────────────────
# Default admin credentials (created on first run)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@spendsense.com
ADMIN_PASSWORD=Admin@123

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=True
